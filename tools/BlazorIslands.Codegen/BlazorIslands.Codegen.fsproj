<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>blazor-islands-codegen</ToolCommandName>
    <PackageId>BlazorIslands.Codegen</PackageId>
    <Description>Generates TypeScript declarations for [TypeScript] island props and Web API DTOs written in C# or F#.</Description>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BlazorIslands.Server\BlazorIslands.Server.fsproj" />
  </ItemGroup>

</Project>
